# Application Configuration

VITE_APP_TITLE="Reality Demo Frontend" # The display name for the application, shown in browser tabs or headers.

# API Endpoints

VITE_REALITY_API_BASE_URL="your_backend_api_base_url_here" # The base URL for the main backend API that this frontend communicates with.
VITE_REALITY_AUTH_URL="your_auth_service_url_here" # The base URL for the authentication service or endpoint (e.g., for login/signup, if separate).

# API Authentication

VITE_REALITY_AUTH_CLIENT_ID="your_oauth_client_id_here" # Client ID used for OAuth/OIDC flows to authenticate with the backend.
# VITE_REALITY_API_KEY="your_optional_public_api_key_here" # An optional public API key for client identification or specific unauthenticated API access.

# Feature Flags & Development Utilities

VITE_MOCK_API_ENABLED="false" # Set to "true" to use mock data services (src/api/mockDataService.ts) instead of live API calls.
VITE_ENABLE_ANALYTICS="false" # Set to "true" to enable analytics tracking if integrated.

# External Services (Optional)

# VITE_ANALYTICS_TRACKING_ID="your_analytics_tracking_id_here" # The tracking ID for your analytics provider (e.g., Google Analytics, Matomo).
# VITE_SENTRY_DSN="your_sentry_dsn_here" # The DSN (Data Source Name) for Sentry error monitoring.
